<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Student.Pages.CoursePage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*"><Grid BackgroundColor="White" Padding="22,0" ColumnDefinitions="Auto,*,Auto"><Button Text="← Menú" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack"/><Label Grid.Column="1" Text="Asignatura" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/><Border Grid.Column="2" BackgroundColor="#FDECEC" Padding="12,7" StrokeThickness="0" VerticalOptions="Center"><Label Text="62% completado" TextColor="{StaticResource BrandRed}" FontAttributes="Bold"/></Border></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="24,26,24,90" Spacing="20" MaximumWidthRequest="980" HorizontalOptions="Center">
            <Border Padding="26"><Grid ColumnDefinitions="90,*" ColumnSpacing="20"><Border BackgroundColor="#FDECEC" WidthRequest="82" HeightRequest="82" StrokeThickness="0"><Label Text="∑" FontSize="38" TextColor="{StaticResource BrandRed}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="Álgebra Octavo B" Style="{StaticResource PageTitle}"/><Label Text="Matemáticas · 8° B · Prof. Elena Castillo" Style="{StaticResource Muted}"/><ProgressBar Progress="0.62" ProgressColor="{StaticResource BrandRed}" Margin="0,10,0,0"/></VerticalStackLayout></Grid></Border>
            <Label Text="Tu ruta de aprendizaje" FontSize="22" FontAttributes="Bold"/>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource BrandRed}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="✓" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 1 · Lenguaje algebraico" FontSize="18" FontAttributes="Bold"/><Label Text="Lección 1 · Expresiones algebraicas" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="#EEEEEE"/><Label Text="✓ Variables y constantes"/><Label Text="✓ Construye una expresión"/></VerticalStackLayout></Border>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource BrandYellow}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="2" TextColor="#6B5800" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 2 · Ecuaciones lineales" FontSize="18" FontAttributes="Bold"/><Label Text="Lección 2 · Igualdades y equivalencias" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="#EEEEEE"/><Label Text="✓ La balanza algebraica · Video"/><Label Text="○ Resuelve paso a paso · Práctica"/></VerticalStackLayout></Border>
            <Border Padding="22"><VerticalStackLayout Spacing="15"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="{StaticResource BrandBlue}" WidthRequest="38" HeightRequest="38" StrokeThickness="0"><Label Text="3" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 3 · Aplicaciones y reto final" FontSize="18" FontAttributes="Bold"/><Label Text="Lección 3 · Modelación y evaluación" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid><BoxView HeightRequest="1" Color="#EEEEEE"/><Label Text="○ Problemas de contexto · Taller"/><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="Quiz: Conociendo México" FontAttributes="Bold"/><Label Text="Actividad final · 5 preguntas" Style="{StaticResource Muted}"/></VerticalStackLayout><Button Grid.Column="1" Text="Comenzar quiz" Style="{StaticResource PrimaryButton}" WidthRequest="160" Clicked="OnQuiz"/></Grid></VerticalStackLayout></Border>
        </VerticalStackLayout></ScrollView>
    </Grid>
</ContentPage>
