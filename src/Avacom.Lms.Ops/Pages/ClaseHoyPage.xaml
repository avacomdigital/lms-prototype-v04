<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.ClaseHoyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" Padding="0">
        <!-- Barra superior · glass chrome: sólo etiquetas cortas -->
        <Border x:Name="BarraSuperior" Grid.Row="0" Margin="24,16,24,0" Padding="16,10" BackgroundColor="#B3FFFFFF" Stroke="#17000000" StrokeThickness="1" StrokeShape="RoundRectangle 22">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button x:Name="VolverBtn" Text="←  Menú" BackgroundColor="Transparent" TextColor="#27272A" FontSize="18" FontAttributes="Bold" HeightRequest="52" Clicked="OnVolver" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="Clase de hoy" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label x:Name="SubtituloLabel" Text="Materias asignadas" FontSize="14" TextColor="#52525B" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <Border x:Name="FuenteChip" Grid.Column="2" BackgroundColor="#FEF9E6" Padding="12,7" StrokeThickness="0" StrokeShape="RoundRectangle 999" VerticalOptions="Center">
                    <Label x:Name="FuenteChipLabel" Text="●  Comprobando…" FontSize="13" FontAttributes="Bold" TextColor="#6B5800" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="48,28,48,80" Spacing="22" MaximumWidthRequest="1120" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="¿Qué vas a dar hoy?" FontSize="32" FontAttributes="Bold" />
                    <Label Text="Toca una materia para ver sus cursos y elige la lección con la que empieza la clase. El curso lo entrega AVACOM Biblioteca; aquí sólo se da la clase." FontSize="16" TextColor="#52525B" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="AvisoHost" Spacing="10" />
                <FlexLayout x:Name="HexHost" Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignItems="Center" />
                <VerticalStackLayout x:Name="ListaHost" Spacing="14" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
