<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Student.Pages.AsignaturasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="White" Padding="22,0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="← Menú" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack" />
            <Label Grid.Column="1" Text="Asignaturas" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border x:Name="EstadoChip" Grid.Column="2" BackgroundColor="#E6F6FC" Padding="12,7" StrokeThickness="0" VerticalOptions="Center">
                <Label x:Name="EstadoChipLabel" Text="●  Buscando cursos…" TextColor="{StaticResource BrandBlue}" FontSize="13" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,90" Spacing="20" MaximumWidthRequest="980" HorizontalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label x:Name="SaludoLabel" Text="Tus cursos" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label Text="Elige una asignatura para ver todo su contenido. Tu avance se guarda solo." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border x:Name="AvisoCard" IsVisible="False" Padding="18" StrokeThickness="0" BackgroundColor="#FDECEC">
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="AvisoTitulo" Text="" FontAttributes="Bold" TextColor="#8A1C1F" LineBreakMode="WordWrap" />
                        <Label x:Name="AvisoDetalle" Text="" FontSize="13" TextColor="#8A1C1F" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="Reintentar" Style="{StaticResource DarkButton}" HeightRequest="42" WidthRequest="130" Clicked="OnActualizar" />
                            <Button x:Name="DemoBtn" Text="Ver curso demo" BackgroundColor="White" TextColor="{StaticResource Ink}" CornerRadius="14" HeightRequest="42" WidthRequest="150" IsVisible="False" Clicked="OnDemo" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <FlexLayout x:Name="HexHost" Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignItems="Center" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Lista completa" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Actualizar" Style="{StaticResource DarkButton}" HeightRequest="40" WidthRequest="120" Clicked="OnActualizar" />
                </Grid>
                <VerticalStackLayout x:Name="ListaHost" Spacing="12" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
