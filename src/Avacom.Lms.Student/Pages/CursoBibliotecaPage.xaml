<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Student.Pages.CursoBibliotecaPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="White" Padding="22,0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="← Asignaturas" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack" />
            <Label x:Name="TituloLabel" Grid.Column="1" Text="Asignatura" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="TailTruncation" />
            <Border Grid.Column="2" BackgroundColor="#FDECEC" Padding="12,7" StrokeThickness="0" VerticalOptions="Center">
                <Label x:Name="ProgresoChip" Text="0% completado" TextColor="{StaticResource BrandRed}" FontAttributes="Bold" />
            </Border>
        </Grid>
        <Grid Grid.Row="1" Padding="20,16,20,20">
            <ui:CourseContentView x:Name="Contenido" />
        </Grid>
    </Grid>
</ContentPage>
