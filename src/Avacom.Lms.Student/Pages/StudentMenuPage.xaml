<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Student.Pages.StudentMenuPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:ui="clr-namespace:Avacom.Lms.Ui.Controls;assembly=Avacom.Lms.Ui" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="72,*,72" BackgroundColor="{StaticResource CanvasGray}">
        <Grid Padding="24,0" ColumnDefinitions="*,Auto"><HorizontalStackLayout VerticalOptions="Center"><Label Text="⬡" FontSize="34" TextColor="{StaticResource BrandRed}"/><Label Text="AVACOM  CLASSROOM" FontAttributes="Bold" FontSize="17" VerticalTextAlignment="Center"/></HorizontalStackLayout><HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="9"><Border BackgroundColor="#6B6B6B" WidthRequest="42" HeightRequest="42" StrokeThickness="0"><Label Text="EM" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout VerticalOptions="Center" Spacing="0"><Label x:Name="StudentName" Text="Ethan" FontAttributes="Bold"/><Label Text="Estudiante" FontSize="12"/></VerticalStackLayout></HorizontalStackLayout></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Spacing="4" Padding="16,12,16,30" HorizontalOptions="Center"><VerticalStackLayout HorizontalOptions="Center" Margin="0,0,0,10"><Label x:Name="WelcomeLabel" Text="Bienvenido" FontSize="25" FontAttributes="Bold" HorizontalTextAlignment="Center"/><Label Text="¿Qué quieres hacer hoy?" Style="{StaticResource Muted}" HorizontalTextAlignment="Center"/></VerticalStackLayout>
            <HorizontalStackLayout Spacing="-4" HorizontalOptions="Center"><ui:HexagonButton Text="Asignaturas" Icon="▤" AccentColor="{StaticResource BrandRed}" WidthRequest="136" HeightRequest="157" Tapped="OnCourses"/><ui:HexagonButton Text="Comunicación" Icon="♧" AccentColor="{StaticResource BrandRed}" WidthRequest="136" HeightRequest="157"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="-4" HorizontalOptions="Center" Margin="0,-24,0,0"><ui:HexagonButton Text="Enciclopedia" Icon="▥" AccentColor="{StaticResource BrandYellow}" WidthRequest="136" HeightRequest="157"/><ui:HexagonButton Text="Perfil" Icon="○" AccentColor="{StaticResource Ink}" WidthRequest="136" HeightRequest="157"/><ui:HexagonButton Text="Progreso" Icon="↗" AccentColor="{StaticResource BrandViolet}" WidthRequest="136" HeightRequest="157"/></HorizontalStackLayout>
            <HorizontalStackLayout Spacing="-4" HorizontalOptions="Center" Margin="0,-24,0,0"><ui:HexagonButton Text="Calendario" Icon="▦" AccentColor="{StaticResource BrandGreen}" WidthRequest="136" HeightRequest="157"/><ui:HexagonButton Text="Ayuda" Icon="?" AccentColor="{StaticResource BrandBlue}" WidthRequest="136" HeightRequest="157"/></HorizontalStackLayout>
        </VerticalStackLayout></ScrollView>
        <Border Grid.Row="2" Margin="20,5" Padding="18,8" BackgroundColor="#5A5A56" StrokeThickness="0" HorizontalOptions="Center"><HorizontalStackLayout Spacing="24"><Button Text="⌂  Menú" BackgroundColor="Transparent" TextColor="White"/><Button Text="▤  Asignaturas" BackgroundColor="Transparent" TextColor="White" Clicked="OnCourses"/><Button Text="?  Ayuda" BackgroundColor="Transparent" TextColor="White"/><Button Text="↪  Salir" BackgroundColor="Transparent" TextColor="White" Clicked="OnLogout"/></HorizontalStackLayout></Border>
    </Grid>
</ContentPage>
