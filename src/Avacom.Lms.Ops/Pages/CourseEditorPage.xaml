<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Avacom.Lms.Ops.Pages.CourseEditorPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="White" Padding="28,0" ColumnDefinitions="Auto,*,Auto"><Button Text="← Volver" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack"/><Label Grid.Column="1" Text="Crear curso" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold"/><Button Grid.Column="2" Text="Guardar curso" Style="{StaticResource PrimaryButton}" WidthRequest="160" Clicked="OnSave"/></Grid>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="48,32,48,80" Spacing="22" MaximumWidthRequest="1050" HorizontalOptions="Center">
            <Label Text="Diseña una experiencia de aprendizaje" Style="{StaticResource PageTitle}"/><Label Text="Crea la estructura que recibirán los estudiantes. Puedes ajustar cada unidad, lección y actividad." Style="{StaticResource Muted}"/>
            <Border Padding="26"><VerticalStackLayout Spacing="14"><Label Text="Información general" FontSize="20" FontAttributes="Bold"/><Grid ColumnDefinitions="2*,*" ColumnSpacing="16"><VerticalStackLayout><Label Text="Nombre del curso"/><Entry x:Name="CourseName" Text="Álgebra Octavo B"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1"><Label Text="Grado"/><Picker x:Name="GradePicker" Title="Selecciona" ItemsSource="{Binding Grades}" SelectedIndex="1" BackgroundColor="White" HeightRequest="52"/></VerticalStackLayout></Grid><Label Text="Descripción"/><Editor Text="Fundamentos de álgebra, ecuaciones lineales y aplicaciones para estudiantes de octavo." HeightRequest="90" BackgroundColor="#FAFAFA"/></VerticalStackLayout></Border>
            <Grid ColumnDefinitions="*,Auto"><Label Text="Estructura del curso" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"/><Button Grid.Column="1" Text="+ Agregar unidad" Style="{StaticResource DarkButton}" Clicked="OnAddUnit"/></Grid>
            <VerticalStackLayout x:Name="UnitsContainer" Spacing="14">
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#FDECEC" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="1" TextColor="{StaticResource BrandRed}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 1 · Lenguaje algebraico" FontSize="18" FontAttributes="Bold"/><Label Text="Lección: Expresiones algebraicas"/><Label Text="• Variables y constantes  ·  • Construye una expresión" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#FEF9E6" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="2" TextColor="#6B5800" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 2 · Ecuaciones lineales" FontSize="18" FontAttributes="Bold"/><Label Text="Lección: Igualdades y equivalencias"/><Label Text="• La balanza algebraica  ·  • Resuelve paso a paso" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
                <Border Padding="22"><Grid ColumnDefinitions="48,*"><Border BackgroundColor="#E6F6FC" StrokeThickness="0" WidthRequest="38" HeightRequest="38"><Label Text="3" TextColor="{StaticResource BrandBlue}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/></Border><VerticalStackLayout Grid.Column="1"><Label Text="Unidad 3 · Aplicaciones y reto final" FontSize="18" FontAttributes="Bold"/><Label Text="Lección: Modelación y evaluación"/><Label Text="• Problemas de contexto  ·  • Quiz: Conociendo México (5 preguntas)" Style="{StaticResource Muted}"/></VerticalStackLayout></Grid></Border>
            </VerticalStackLayout>
        </VerticalStackLayout></ScrollView>
    </Grid>
</ContentPage>
