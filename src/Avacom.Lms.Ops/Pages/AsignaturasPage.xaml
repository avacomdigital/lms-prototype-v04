<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Avacom.Lms.Ops.Pages.AsignaturasPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="68,*">
        <Grid BackgroundColor="White" Padding="28,0" ColumnDefinitions="Auto,*,Auto">
            <Button Text="← Volver" BackgroundColor="Transparent" TextColor="{StaticResource Ink}" Clicked="OnBack" />
            <Label Grid.Column="1" Text="Asignaturas · cursos de AVACOM Biblioteca" HorizontalOptions="Center" VerticalOptions="Center" FontSize="18" FontAttributes="Bold" />
            <Border x:Name="EstadoChip" Grid.Column="2" BackgroundColor="{StaticResource ErrorSoft}" Padding="12,7" StrokeThickness="0" VerticalOptions="Center">
                <Label x:Name="EstadoChipLabel" Text="●  Comprobando biblioteca…" TextColor="{StaticResource BrandRed}" FontSize="13" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="48,28,48,80" Spacing="22" MaximumWidthRequest="1120" HorizontalOptions="Center">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout>
                        <Label Text="Cursos disponibles" Style="{StaticResource PageTitle}" />
                        <Label x:Name="IntroLabel" Text="Lo que se ofrece en este equipo lo decide AVACOM Biblioteca. Aquí se muestran los cursos y se registra lo que hacen los estudiantes con ellos." Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Actualizar" Style="{StaticResource DarkButton}" WidthRequest="150" VerticalOptions="Start" Clicked="OnActualizar" />
                </Grid>

                <Border x:Name="AvisoCard" IsVisible="False" Padding="18" StrokeThickness="0" BackgroundColor="{StaticResource ErrorSoft}">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="AvisoTitulo" Text="" FontAttributes="Bold" TextColor="#8A1C1F" LineBreakMode="WordWrap" />
                        <Label x:Name="AvisoDetalle" Text="" FontSize="13" TextColor="#8A1C1F" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Los cursos como hexágonos, con la misma pieza del menú principal -->
                <FlexLayout x:Name="HexHost" Wrap="Wrap" Direction="Row" JustifyContent="Center" AlignItems="Center" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Lista completa" FontSize="21" FontAttributes="Bold" VerticalOptions="Center" />
                    <Label x:Name="ConteoLabel" Grid.Column="1" Text="" Style="{StaticResource Muted}" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout x:Name="ListaHost" Spacing="12" />

                <Border Padding="18" StrokeThickness="0" BackgroundColor="#E6F6FC">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="¿Falta un curso?" FontAttributes="Bold" TextColor="#0B5E80" />
                        <Label Text="Los cursos se instalan y administran en AVACOM Biblioteca (pestaña Administración → Instalar paquetes). Lo que la escuela desactive por política no aparece aquí. Este panel nunca crea ni edita cursos." Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
